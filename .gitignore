# FreeCAD 源码目录（本地依赖，不入库）
free-cad/

# macOS
.DS_Store

# 编辑器
.idea/
.vscode/
*.swp

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 测试与构建产物
.pytest_tmp/
.pytest_cache/
build/
dist/

# 运行期数据（IR 快照、事件流、SQLite、导出的 STEP/STL）
data/

# 冒烟/探测脚本的临时输出（脚本本身在 tools/probes/ 下，需要提交）
tools/probes/*.step
tools/probes/*.stl
tools/probes/*.FCStd

# 本地运行期工作区：data/ 是默认数据目录；.tcad_* 是临时/演示/验证用的。
# 用通配而不是逐条列举 —— 验证时随手起的目录名不会提前知道，漏一个就会把
# 运行期数据提交进仓库。
.tcad_*/
